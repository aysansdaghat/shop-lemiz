# ===== نمونه تنظیمات محیطی — این فایل را کپی و مقادیر را تنظیم کنید =====
# کپی: cp .env.example .env

# کلید امنیتی جنگو (در محیط واقعی یک مقدار تصادفی بلند بگذارید)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# حالت دیباگ (True/False)
DJANGO_DEBUG=True

# دامنه‌های مجاز برای CORS (با کاما جدا کنید)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== پایگاه داده =====
# موتور: sqlite یا mssql
DB_ENGINE=sqlite

# --- تنظیمات SQLite (پیش‌فرض توسعه/تست) ---
SQLITE_NAME=db.sqlite3

# --- تنظیمات SQL Server (در صورت DB_ENGINE=mssql) ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=lemiz_shop
DB_USER=sa
DB_PASSWORD=your-strong-password
DB_TRUSTED_CONNECTION=False
# آدرس درایور ODBC (برای ویندوز معمولاً یکی از این‌هاست)
DB_DRIVER=ODBC Driver 17 for SQL Server

# ===== زمان =====
DJANGO_TIME_ZONE=Asia/Tehran
DJANGO_LANGUAGE_CODE=fa-ir